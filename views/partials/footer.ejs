  <!-- Footer -->
  <footer class="mt-auto bg-[#0a0f1d] border-t border-slate-800/80 text-slate-400 text-xs">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8">
        
        <!-- About Site -->
        <div class="md:col-span-2 space-y-3">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-white font-bold">
              <i class="fa-solid fa-cube text-sm"></i>
            </div>
            <span class="text-base font-black text-white"><%= settings.site_name || 'Khanza.NET SOFTWARE' %></span>
          </div>
          <p class="text-xs text-slate-400 leading-relaxed max-w-md">
            <%= settings.site_description || 'Portal download software Windows, Mac, game PC repack full version gratis dan selalu update setiap hari dengan direct mirror tercepat.' %>
          </p>
          <div class="flex items-center gap-3 pt-2">
            <% if (settings.telegram_url) { %>
              <a href="<%= settings.telegram_url %>" target="_blank" class="w-8 h-8 rounded-full bg-slate-800 text-slate-300 hover:text-white hover:bg-sky-500 flex items-center justify-center transition">
                <i class="fa-brands fa-telegram text-sm"></i>
              </a>
            <% } %>
            <% if (settings.discord_url) { %>
              <a href="<%= settings.discord_url %>" target="_blank" class="w-8 h-8 rounded-full bg-slate-800 text-slate-300 hover:text-white hover:bg-indigo-600 flex items-center justify-center transition">
                <i class="fa-brands fa-discord text-sm"></i>
              </a>
            <% } %>
            <% if (settings.youtube_url) { %>
              <a href="<%= settings.youtube_url %>" target="_blank" class="w-8 h-8 rounded-full bg-slate-800 text-slate-300 hover:text-white hover:bg-rose-600 flex items-center justify-center transition">
                <i class="fa-brands fa-youtube text-sm"></i>
              </a>
            <% } %>
          </div>
        </div>

        <!-- Quick Links -->
        <div>
          <h4 class="text-xs font-bold text-white uppercase tracking-wider mb-3">Tautan Cepat</h4>
          <ul class="space-y-2">
            <li><a href="/" class="hover:text-blue-400 transition">Beranda</a></li>
            <li><a href="/request" class="hover:text-blue-400 transition">Request Software</a></li>
            <li><a href="/how-to-download" class="hover:text-blue-400 transition">Panduan Cara Download</a></li>
            <li><a href="/p/dmca-disclaimer" class="hover:text-blue-400 transition">DMCA & Disclaimer</a></li>
            <li><a href="/admin/login" class="hover:text-blue-400 transition">Admin CMS Login</a></li>
          </ul>
        </div>

        <!-- Popular Categories -->
        <div>
          <h4 class="text-xs font-bold text-white uppercase tracking-wider mb-3">Kategori Pilihan</h4>
          <ul class="space-y-2">
            <% if (typeof navCategories !== 'undefined') { %>
              <% navCategories.slice(0, 5).forEach(cat => { %>
                <li>
                  <a href="/category/<%= cat.slug %>" class="hover:text-blue-400 transition flex items-center gap-1.5">
                    <i class="fa-solid fa-angle-right text-[10px] text-slate-600"></i>
                    <%= cat.name %>
                  </a>
                </li>
              <% }) %>
            <% } %>
          </ul>
        </div>

      </div>

      <!-- Bottom Copyright & RAR Password Notice -->
      <div class="pt-8 border-t border-slate-800/80 flex flex-col md:flex-row items-center justify-between gap-4 text-[11px] text-slate-500">
        <div>
          <%= settings.footer_text || '© 2026 Khanza.NET. All Rights Reserved.' %>
        </div>
        <div class="flex items-center gap-2">
          <span>Standard Password RAR:</span>
          <code class="bg-slate-800 text-blue-400 px-2 py-0.5 rounded font-mono font-bold select-all"><%= settings.default_rar_password || 'Khanza.NET' %></code>
        </div>
      </div>
    </div>
  </footer>

  <!-- Lightbox Modal for Screenshots -->
  <div id="imageModal" class="fixed inset-0 z-50 bg-black/90 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="relative max-w-5xl max-h-[90vh]">
      <button id="closeModal" class="absolute -top-10 right-0 text-white text-2xl hover:text-rose-400 transition">
        <i class="fa-solid fa-xmark"></i>
      </button>
      <img id="modalImage" src="" alt="Screenshot Full Preview" class="max-w-full max-h-[85vh] object-contain rounded-lg border border-slate-700 shadow-2xl">
    </div>
  </div>

  <!-- Main JavaScript File -->
  <script src="/js/main.js"></script>
</body>
</html>
