<%- include('../layout-header') %>

<div class="space-y-6">

  <div>
    <h1 class="text-xl font-black text-white">Permintaan Software dari Pengunjung</h1>
    <p class="text-xs text-slate-400 mt-0.5">Daftar software dan game yang diminta oleh pengunjung melalui form request.</p>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="p-4 rounded-xl bg-emerald-950/70 border border-emerald-800 text-emerald-300 text-xs font-semibold flex items-center gap-2">
      <i class="fa-solid fa-circle-check text-base"></i>
      <%= success %>
    </div>
  <% } %>

  <div class="bg-[#151f32] border border-slate-800 rounded-2xl overflow-hidden shadow-sm">
    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs text-slate-300">
        <thead class="bg-[#0f172a] text-slate-400 uppercase text-[10px] tracking-wider border-b border-slate-800">
          <tr>
            <th class="py-3.5 px-4">Software yang Diminta</th>
            <th class="py-3.5 px-4">Versi</th>
            <th class="py-3.5 px-4">Pengirim</th>
            <th class="py-3.5 px-4">Catatan</th>
            <th class="py-3.5 px-4">Status & Ubah</th>
            <th class="py-3.5 px-4">Tanggal</th>
            <th class="py-3.5 px-4 text-right">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/80">
          <% if (requests && requests.length > 0) { %>
            <% requests.forEach(r => { %>
              <tr class="hover:bg-slate-800/40 transition">
                <td class="py-3.5 px-4 font-bold text-white"><%= r.software_name %></td>
                <td class="py-3.5 px-4 font-mono text-sky-400"><%= r.version_needed || 'Terbaru' %></td>
                <td class="py-3.5 px-4">
                  <div class="font-semibold text-slate-200"><%= r.name %></div>
                  <div class="text-[11px] text-slate-500"><%= r.email || '-' %></div>
                </td>
                <td class="py-3.5 px-4 max-w-xs text-slate-400 truncate">
                  <%= r.notes || '-' %>
                </td>
                <td class="py-3.5 px-4">
                  <form action="/admin/requests/<%= r.id %>/status" method="POST" class="inline-flex items-center gap-1.5">
                    <select name="status" onchange="this.form.submit()" class="bg-[#121927] border border-slate-700 rounded-lg px-2.5 py-1 text-[11px] font-semibold text-slate-200 focus:outline-none focus:border-blue-500">
                      <option value="pending" <%= r.status === 'pending' ? 'selected' : '' %>>Sedang Diproses</option>
                      <option value="completed" <%= r.status === 'completed' ? 'selected' : '' %>>Sudah Diupload</option>
                      <option value="rejected" <%= r.status === 'rejected' ? 'selected' : '' %>>Ditolak</option>
                    </select>
                  </form>
                </td>
                <td class="py-3.5 px-4 text-slate-500 text-[11px]">
                  <%= formatDate(r.created_at) %>
                </td>
                <td class="py-3.5 px-4 text-right">
                  <form action="/admin/requests/<%= r.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Hapus permintaan ini?');">
                    <button type="submit" class="p-1.5 text-rose-400 hover:text-rose-300" title="Hapus">
                      <i class="fa-solid fa-trash-can"></i>
                    </button>
                  </form>
                </td>
              </tr>
            <% }) %>
          <% } else { %>
            <tr>
              <td colspan="7" class="py-8 text-center text-slate-500">
                Belum ada permintaan software dari pengunjung.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</div>

<%- include('../layout-footer') %>
