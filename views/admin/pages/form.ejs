<%- include('../layout-header') %>

<div class="max-w-4xl space-y-6">

  <div class="flex items-center justify-between pb-4 border-b border-slate-800">
    <div>
      <h1 class="text-xl font-black text-white"><%= title %></h1>
      <p class="text-xs text-slate-400 mt-0.5">Edit konten halaman statis (Mendukung format HTML).</p>
    </div>
    <a href="/admin/pages" class="bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold text-xs py-2 px-4 rounded-xl transition border border-slate-700">
      Kembali
    </a>
  </div>

  <form action="/admin/pages/<%= page.id %>/edit" method="POST" class="bg-[#151f32] border border-slate-800 rounded-2xl p-6 shadow-sm space-y-5">
    <div>
      <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">Judul Halaman *</label>
      <input type="text" name="title" required value="<%= page.title %>" class="w-full bg-[#121927] border border-slate-700 rounded-xl px-4 py-2.5 text-sm text-white font-semibold focus:outline-none focus:border-blue-500">
    </div>

    <div>
      <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">Slug URL</label>
      <input type="text" readonly value="<%= page.slug %>" class="w-full bg-[#0f172a] border border-slate-800 rounded-xl px-4 py-2 text-xs text-slate-400 font-mono cursor-not-allowed">
    </div>

    <div>
      <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">Konten Halaman (HTML)</label>
      <textarea name="content" rows="12" class="w-full bg-[#121927] border border-slate-700 rounded-xl p-4 text-xs text-white placeholder-slate-500 font-mono leading-relaxed focus:outline-none focus:border-blue-500"><%= page.content %></textarea>
    </div>

    <div class="pt-2">
      <button type="submit" class="bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs py-2.5 px-6 rounded-xl shadow-md transition flex items-center gap-2">
        <i class="fa-solid fa-floppy-disk"></i> Simpan Perubahan Halaman
      </button>
    </div>
  </form>

</div>

<%- include('../layout-footer') %>
