<%- include('../layout-header') %>

<div class="space-y-8 max-w-5xl">

  <div>
    <h1 class="text-xl font-black text-white">Pengaturan Website & Akun Admin</h1>
    <p class="text-xs text-slate-400 mt-0.5">Sesuaikan identitas situs, password default WinRAR, pengumuman, dan kata sandi admin.</p>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="p-4 rounded-xl bg-emerald-950/70 border border-emerald-800 text-emerald-300 text-xs font-semibold flex items-center gap-2">
      <i class="fa-solid fa-circle-check text-base"></i>
      <%= success %>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="p-4 rounded-xl bg-rose-950/70 border border-rose-800 text-rose-300 text-xs font-semibold flex items-center gap-2">
      <i class="fa-solid fa-circle-exclamation text-base"></i>
      <%= error %>
    </div>
  <% } %>

  <!-- Form 1: Website General Settings -->
  <div class="bg-[#151f32] border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-sm">
    <h2 class="text-sm font-bold text-white uppercase tracking-wider pb-4 mb-6 border-b border-slate-800 flex items-center gap-2">
      <i class="fa-solid fa-globe text-blue-400"></i> Pengaturan Umum Website
    </h2>

    <form action="/admin/settings" method="POST" class="space-y-5">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">Nama Situs (Site Name)</label>
          <input type="text" name="site_name" value="<%= settings.site_name || 'Khanza.NET SOFTWARE' %>" required class="w-full bg-[#121927] border border-slate-700 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-blue-500 font-bold">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">Default Password WinRAR</label>
          <input type="text" name="default_rar_password" value="<%= settings.default_rar_password || 'Khanza.NET' %>" required class="w-full bg-[#121927] border border-slate-700 rounded-xl px-4 py-2.5 text-xs text-amber-400 font-mono font-bold focus:outline-none focus:border-blue-500">
        </div>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1.5">Tagline Website</label>
        <input type="text" name="site_tagline" value="<%= settings.site_tagline || '' %>" class="w-full bg-[#121927] border border-slate-700 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-blue-500">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1.5">Deskripsi SEO Situs</label>
        <textarea name="site_description" rows="2" class="w-full bg-[#121927] border border-slate-700 rounded-xl px-4 py-2 text-xs text-white focus:outline-none focus:border-blue-500"><%= settings.site_description || '' %></textarea>
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1.5">Teks Pengumuman Header (Ticker Bar)</label>
        <textarea name="announcement" rows="2" class="w-full bg-[#121927] border border-slate-700 rounded-xl px-4 py-2 text-xs text-white focus:outline-none focus:border-blue-500 font-mono"><%= settings.announcement || '' %></textarea>
        <span class="text-[11px] text-slate-500 mt-1 block">Mendukung format HTML ringan (e.g. &lt;strong&gt;, &lt;a&gt;)</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">Link Telegram Channel</label>
          <input type="url" name="telegram_url" value="<%= settings.telegram_url || '' %>" placeholder="https://t.me/..." class="w-full bg-[#121927] border border-slate-700 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-blue-500 font-mono">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">Link Discord Server</label>
          <input type="url" name="discord_url" value="<%= settings.discord_url || '' %>" placeholder="https://discord.gg/..." class="w-full bg-[#121927] border border-slate-700 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-blue-500 font-mono">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">Link YouTube Channel</label>
          <input type="url" name="youtube_url" value="<%= settings.youtube_url || '' %>" placeholder="https://youtube.com/..." class="w-full bg-[#121927] border border-slate-700 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-blue-500 font-mono">
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">Email Kontak / Support</label>
          <input type="email" name="contact_email" value="<%= settings.contact_email || '' %>" placeholder="support@khanza.net" class="w-full bg-[#121927] border border-slate-700 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-blue-500">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">Teks Copyright Footer</label>
          <input type="text" name="footer_text" value="<%= settings.footer_text || '' %>" class="w-full bg-[#121927] border border-slate-700 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-blue-500">
        </div>
      </div>

      <div class="pt-2">
        <button type="submit" class="bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs py-2.5 px-6 rounded-xl shadow-md transition flex items-center gap-2">
          <i class="fa-solid fa-floppy-disk"></i> Simpan Pengaturan Situs
        </button>
      </div>
    </form>
  </div>

  <!-- Form 2: Change Admin Account & Password -->
  <div class="bg-[#151f32] border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-sm">
    <h2 class="text-sm font-bold text-white uppercase tracking-wider pb-4 mb-6 border-b border-slate-800 flex items-center gap-2">
      <i class="fa-solid fa-user-shield text-emerald-400"></i> Akun Admin & Keamanan
    </h2>

    <form action="/admin/profile/update" method="POST" class="space-y-4 max-w-lg">
      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1.5">Username Admin</label>
        <input type="text" name="username" value="<%= currentUser ? currentUser.username : 'admin' %>" required class="w-full bg-[#121927] border border-slate-700 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-blue-500 font-semibold">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1.5">Password Saat Ini (Dibutuhkan untuk konfirmasi) *</label>
        <input type="password" name="current_password" required placeholder="••••••••" class="w-full bg-[#121927] border border-slate-700 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-blue-500">
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">Password Baru (Opsional)</label>
          <input type="password" name="new_password" placeholder="Minimal 6 karakter" class="w-full bg-[#121927] border border-slate-700 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-blue-500">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-300 mb-1.5">Ulangi Password Baru</label>
          <input type="password" name="confirm_password" placeholder="Ulangi password" class="w-full bg-[#121927] border border-slate-700 rounded-xl px-4 py-2.5 text-xs text-white focus:outline-none focus:border-blue-500">
        </div>
      </div>

      <div class="pt-2">
        <button type="submit" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs py-2.5 px-6 rounded-xl shadow-md transition flex items-center gap-2">
          <i class="fa-solid fa-key"></i> Perbarui Akun & Password
        </button>
      </div>
    </form>
  </div>

</div>

<%- include('../layout-footer') %>
