<!DOCTYPE html>
<html lang="id" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-[#0b1120] text-slate-100 min-h-screen flex items-center justify-center p-4">

  <div class="w-full max-w-md">
    
    <!-- Brand Header -->
    <div class="text-center mb-8">
      <div class="inline-flex w-16 h-16 rounded-2xl bg-gradient-to-tr from-blue-600 to-indigo-600 items-center justify-center text-white text-3xl shadow-xl shadow-blue-500/25 mb-4">
        <i class="fa-solid fa-cube"></i>
      </div>
      <h1 class="text-2xl font-black text-white tracking-wide">CMS ADMIN PANEL</h1>
      <p class="text-xs text-slate-400 mt-1">Masuk untuk mengelola postingan software, kategori, dan konten situs.</p>
    </div>

    <!-- Login Card -->
    <div class="bg-[#151f32] border border-slate-800 rounded-2xl p-6 sm:p-8 shadow-2xl">
      
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-6 p-4 rounded-xl bg-rose-950/70 border border-rose-800 text-rose-300 text-xs font-semibold flex items-center gap-2">
          <i class="fa-solid fa-circle-exclamation text-base"></i>
          <%= error %>
        </div>
      <% } %>

      <form action="/admin/login" method="POST" class="space-y-5">
        <div>
          <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">Username</label>
          <div class="relative">
            <span class="absolute left-3.5 top-2.5 text-slate-500">
              <i class="fa-solid fa-user text-sm"></i>
            </span>
            <input 
              type="text" 
              name="username" 
              required 
              placeholder="admin" 
              class="w-full bg-[#121927] border border-slate-700 rounded-xl pl-10 pr-4 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition"
            >
          </div>
        </div>

        <div>
          <label class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-2">Password</label>
          <div class="relative">
            <span class="absolute left-3.5 top-2.5 text-slate-500">
              <i class="fa-solid fa-lock text-sm"></i>
            </span>
            <input 
              type="password" 
              name="password" 
              required 
              placeholder="••••••••" 
              class="w-full bg-[#121927] border border-slate-700 rounded-xl pl-10 pr-4 py-2.5 text-sm text-white placeholder-slate-500 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition"
            >
          </div>
        </div>

        <button 
          type="submit" 
          class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold text-sm py-3 px-4 rounded-xl shadow-lg shadow-blue-600/30 transition flex items-center justify-center gap-2"
        >
          <i class="fa-solid fa-right-to-bracket"></i> Masuk ke CMS
        </button>
      </form>

      <!-- Default Credential Notice -->
      <div class="mt-6 pt-5 border-t border-slate-800 text-[11px] text-slate-400 text-center">
        <span>Akun bawaan sistem:</span>
        <div class="mt-1 font-mono text-blue-400 font-bold bg-slate-900 py-1.5 px-3 rounded-lg border border-slate-800">
          admin / admin123
        </div>
      </div>

    </div>

    <!-- Back to Website -->
    <div class="text-center mt-6">
      <a href="/" class="text-xs font-semibold text-slate-400 hover:text-white transition flex items-center justify-center gap-2">
        <i class="fa-solid fa-arrow-left text-[10px]"></i> Kembali ke Halaman Utama Website
      </a>
    </div>

  </div>

</body>
</html>
