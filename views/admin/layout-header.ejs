<!DOCTYPE html>
<html lang="id" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? `${title} - CMS Admin` : 'CMS Admin Panel' %></title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              500: '#3b82f6',
              600: '#2563eb',
            }
          }
        }
      }
    }
  </script>
  <style>
    body { font-family: 'Plus Jakarta Sans', system-ui, sans-serif; background-color: #0b1120; }
  </style>
</head>
<body class="bg-[#0b1120] text-slate-100 min-h-screen flex antialiased">

  <!-- Admin Sidebar -->
  <aside class="w-64 bg-[#0f172a] border-r border-slate-800 flex flex-col shrink-0 min-h-screen fixed lg:static z-40 transition-transform -translate-x-full lg:translate-x-0" id="adminSidebar">
    
    <!-- Sidebar Brand -->
    <div class="h-16 flex items-center px-6 border-b border-slate-800 gap-3">
      <div class="w-9 h-9 rounded-xl bg-blue-600 flex items-center justify-center text-white shadow-lg shadow-blue-500/30 font-black">
        <i class="fa-solid fa-cube text-base"></i>
      </div>
      <div>
        <span class="text-sm font-black text-white tracking-wide">CMS ADMIN</span>
        <span class="block text-[10px] text-blue-400 font-semibold -mt-1"><%= settings.site_name || 'Khanza.NET' %></span>
      </div>
    </div>

    <!-- Navigation Menu -->
    <nav class="flex-1 px-4 py-6 space-y-1.5 overflow-y-auto">
      
      <a href="/admin" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold <%= currentPath === '/admin' ? 'bg-blue-600 text-white font-bold shadow-md' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %> transition">
        <i class="fa-solid fa-gauge-high text-sm w-4"></i> Dashboard
      </a>

      <div class="pt-4 pb-1 px-3 text-[10px] font-bold text-slate-500 uppercase tracking-wider">KONTEN</div>

      <a href="/admin/posts" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold <%= currentPath.startsWith('/admin/posts') && currentPath !== '/admin/posts/new' ? 'bg-blue-600 text-white font-bold shadow-md' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %> transition">
        <i class="fa-solid fa-layer-group text-sm w-4"></i> Semua Software
      </a>

      <a href="/admin/posts/new" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold <%= currentPath === '/admin/posts/new' ? 'bg-blue-600 text-white font-bold shadow-md' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %> transition">
        <i class="fa-solid fa-circle-plus text-sm w-4 text-emerald-400"></i> Tambah Software
      </a>

      <a href="/admin/categories" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold <%= currentPath === '/admin/categories' ? 'bg-blue-600 text-white font-bold shadow-md' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %> transition">
        <i class="fa-solid fa-folder-tree text-sm w-4"></i> Kategori
      </a>

      <div class="pt-4 pb-1 px-3 text-[10px] font-bold text-slate-500 uppercase tracking-wider">INTERAKSI</div>

      <a href="/admin/requests" class="flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold <%= currentPath === '/admin/requests' ? 'bg-blue-600 text-white font-bold shadow-md' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %> transition">
        <span class="flex items-center gap-3">
          <i class="fa-solid fa-paper-plane text-sm w-4 text-amber-400"></i> Request Software
        </span>
      </a>

      <a href="/admin/broken-links" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold <%= currentPath === '/admin/broken-links' ? 'bg-blue-600 text-white font-bold shadow-md' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %> transition">
        <i class="fa-solid fa-triangle-exclamation text-sm w-4 text-rose-400"></i> Laporan Link Rusak
      </a>

      <a href="/admin/comments" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold <%= currentPath === '/admin/comments' ? 'bg-blue-600 text-white font-bold shadow-md' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %> transition">
        <i class="fa-solid fa-comments text-sm w-4 text-sky-400"></i> Komentar
      </a>

      <a href="/admin/pages" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold <%= currentPath === '/admin/pages' ? 'bg-blue-600 text-white font-bold shadow-md' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %> transition">
        <i class="fa-solid fa-file-lines text-sm w-4"></i> Halaman Statis
      </a>

      <div class="pt-4 pb-1 px-3 text-[10px] font-bold text-slate-500 uppercase tracking-wider">SISTEM</div>

      <a href="/admin/ads" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold <%= currentPath === '/admin/ads' ? 'bg-blue-600 text-white font-bold shadow-md' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %> transition">
        <i class="fa-solid fa-rectangle-ad text-sm w-4 text-amber-400"></i> Kelola Iklan & Sponsor
      </a>

      <a href="/admin/settings" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold <%= currentPath === '/admin/settings' ? 'bg-blue-600 text-white font-bold shadow-md' : 'text-slate-300 hover:bg-slate-800/80 hover:text-white' %> transition">
        <i class="fa-solid fa-sliders text-sm w-4 text-slate-400"></i> Pengaturan & Akun
      </a>

      <a href="/admin/backup/database" class="flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-emerald-400 hover:bg-emerald-950/40 hover:text-emerald-300 border border-emerald-500/20 transition mt-2">
        <i class="fa-solid fa-database text-sm w-4"></i> Backup Database (1-Klik)
      </a>

    </nav>

    <!-- Bottom Profile & Logout -->
    <div class="p-4 border-t border-slate-800">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2.5 min-w-0">
          <div class="w-8 h-8 rounded-full bg-blue-600 text-white flex items-center justify-center font-bold text-xs uppercase">
            <%= (currentUser && currentUser.username) ? currentUser.username.charAt(0) : 'A' %>
          </div>
          <div class="min-w-0">
            <div class="text-xs font-bold text-white truncate"><%= (currentUser && currentUser.username) ? currentUser.username : 'Admin' %></div>
            <div class="text-[10px] text-emerald-400">Online</div>
          </div>
        </div>
        <a href="/admin/logout" class="text-slate-400 hover:text-rose-400 p-1.5 transition" title="Logout">
          <i class="fa-solid fa-arrow-right-from-bracket text-sm"></i>
        </a>
      </div>
    </div>

  </aside>

  <!-- Main Content Wrapper -->
  <div class="flex-1 flex flex-col min-w-0">
    
    <!-- Topbar Header -->
    <header class="h-16 bg-[#0f172a] border-b border-slate-800 px-6 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <button id="toggleSidebar" class="lg:hidden text-slate-400 hover:text-white p-2 rounded-lg hover:bg-slate-800">
          <i class="fa-solid fa-bars text-lg"></i>
        </button>
        <h2 class="text-base font-bold text-white truncate"><%= title %></h2>
      </div>

      <div class="flex items-center gap-3">
        <a href="/" target="_blank" class="text-xs font-semibold text-slate-300 hover:text-white bg-slate-800 hover:bg-slate-700 px-3.5 py-2 rounded-lg transition flex items-center gap-1.5 border border-slate-700">
          <i class="fa-solid fa-arrow-up-right-from-square text-xs text-blue-400"></i> Buka Website
        </a>
      </div>
    </header>

    <!-- Content View Area -->
    <main class="flex-1 p-6 lg:p-8 overflow-y-auto">
