<%- include('layout-header') %>

<% if (typeof stats !== 'undefined' && stats.pendingBrokenLinks > 0) { %>
  <div class="mb-6 p-4 rounded-2xl bg-rose-950/60 border border-rose-800 text-rose-200 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 shadow-lg">
    <div class="flex items-center gap-3">
      <div class="w-10 h-10 rounded-xl bg-rose-600/30 text-rose-400 flex items-center justify-center text-lg shrink-0">
        <i class="fa-solid fa-triangle-exclamation"></i>
      </div>
      <div>
        <div class="font-bold text-white text-sm">Ada <%= stats.pendingBrokenLinks %> Laporan Link Rusak Perlu Diperbaiki!</div>
        <div class="text-xs text-rose-300">Pengunjung melaporkan link mati atau file corrupt. Segera periksa dan perbarui mirror.</div>
      </div>
    </div>
    <a href="/admin/broken-links" class="bg-rose-600 hover:bg-rose-500 text-white font-bold text-xs py-2 px-4 rounded-xl transition shadow shrink-0 text-center">
      Periksa Laporan
    </a>
  </div>
<% } %>

<!-- Statistics Grid -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
  
  <div class="bg-[#151f32] border border-slate-800 rounded-2xl p-5 shadow-sm">
    <div class="flex items-center justify-between">
      <div>
        <div class="text-xs font-semibold text-slate-400">Total Software</div>
        <div class="text-2xl font-black text-white mt-1"><%= stats.totalPosts %></div>
        <div class="text-[11px] text-emerald-400 mt-1"><%= stats.publishedPosts %> Diterbitkan</div>
      </div>
      <div class="w-12 h-12 rounded-xl bg-blue-600/20 text-blue-400 border border-blue-500/30 flex items-center justify-center text-xl">
        <i class="fa-solid fa-cube"></i>
      </div>
    </div>
  </div>

  <div class="bg-[#151f32] border border-slate-800 rounded-2xl p-5 shadow-sm">
    <div class="flex items-center justify-between">
      <div>
        <div class="text-xs font-semibold text-slate-400">Total Unduhan</div>
        <div class="text-2xl font-black text-white mt-1"><%= stats.totalDownloads %></div>
        <div class="text-[11px] text-blue-400 mt-1">Akumulasi link klik</div>
      </div>
      <div class="w-12 h-12 rounded-xl bg-emerald-600/20 text-emerald-400 border border-emerald-500/30 flex items-center justify-center text-xl">
        <i class="fa-solid fa-cloud-arrow-down"></i>
      </div>
    </div>
  </div>

  <div class="bg-[#151f32] border border-slate-800 rounded-2xl p-5 shadow-sm">
    <div class="flex items-center justify-between">
      <div>
        <div class="text-xs font-semibold text-slate-400">Total Views / Pengunjung</div>
        <div class="text-2xl font-black text-white mt-1"><%= stats.totalViews %></div>
        <div class="text-[11px] text-slate-400 mt-1">Pembaca postingan</div>
      </div>
      <div class="w-12 h-12 rounded-xl bg-indigo-600/20 text-indigo-400 border border-indigo-500/30 flex items-center justify-center text-xl">
        <i class="fa-solid fa-eye"></i>
      </div>
    </div>
  </div>

  <div class="bg-[#151f32] border border-slate-800 rounded-2xl p-5 shadow-sm">
    <div class="flex items-center justify-between">
      <div>
        <div class="text-xs font-semibold text-slate-400">Request Pending</div>
        <div class="text-2xl font-black text-white mt-1"><%= stats.pendingRequests %></div>
        <div class="text-[11px] text-amber-400 mt-1"><%= stats.totalComments %> Komentar masuk</div>
      </div>
      <div class="w-12 h-12 rounded-xl bg-amber-600/20 text-amber-400 border border-amber-500/30 flex items-center justify-center text-xl">
        <i class="fa-solid fa-paper-plane"></i>
      </div>
    </div>
  </div>

</div>

<!-- Quick Shortcuts -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-8">
  <a href="/admin/posts/new" class="bg-gradient-to-r from-blue-600 to-indigo-600 hover:from-blue-500 hover:to-indigo-500 p-5 rounded-2xl shadow-lg transition flex items-center justify-between text-white group">
    <div>
      <div class="text-xs uppercase font-bold tracking-wider text-blue-200">Aksi Cepat</div>
      <div class="text-base font-black mt-0.5">Tambah Software Baru</div>
      <div class="text-xs text-blue-100 mt-1">Upload installer, repack, mirror link & spek</div>
    </div>
    <div class="w-10 h-10 rounded-xl bg-white/20 flex items-center justify-center text-white group-hover:scale-110 transition-transform">
      <i class="fa-solid fa-plus text-lg"></i>
    </div>
  </a>

  <a href="/admin/categories" class="bg-[#151f32] border border-slate-800 hover:border-slate-700 p-5 rounded-2xl shadow-sm transition flex items-center justify-between group">
    <div>
      <div class="text-xs uppercase font-bold tracking-wider text-slate-400">Struktur Konten</div>
      <div class="text-base font-black text-white mt-0.5">Kelola <%= stats.totalCategories %> Kategori</div>
      <div class="text-xs text-slate-400 mt-1">Atur nama, slug, ikon dan warna kategori</div>
    </div>
    <div class="w-10 h-10 rounded-xl bg-slate-800 flex items-center justify-center text-blue-400 group-hover:scale-110 transition-transform">
      <i class="fa-solid fa-folder-tree text-lg"></i>
    </div>
  </a>

  <a href="/admin/requests" class="bg-[#151f32] border border-slate-800 hover:border-slate-700 p-5 rounded-2xl shadow-sm transition flex items-center justify-between group">
    <div>
      <div class="text-xs uppercase font-bold tracking-wider text-slate-400">Suara Pengunjung</div>
      <div class="text-base font-black text-white mt-0.5">Cek Permintaan Software</div>
      <div class="text-xs text-slate-400 mt-1"><%= stats.pendingRequests %> permintaan menunggu respon</div>
    </div>
    <div class="w-10 h-10 rounded-xl bg-slate-800 flex items-center justify-center text-amber-400 group-hover:scale-110 transition-transform">
      <i class="fa-solid fa-inbox text-lg"></i>
    </div>
  </a>
</div>

<!-- Tables Grid: Top Software & Recent Activity -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
  
  <!-- Top Software -->
  <div class="bg-[#151f32] border border-slate-800 rounded-2xl p-6 shadow-sm">
    <div class="flex items-center justify-between pb-4 mb-4 border-b border-slate-800">
      <h3 class="text-sm font-bold text-white uppercase tracking-wider flex items-center gap-2">
        <i class="fa-solid fa-fire text-amber-500"></i> Software Terpopuler
      </h3>
      <a href="/admin/posts" class="text-xs text-blue-400 hover:underline">Lihat Semua</a>
    </div>

    <div class="space-y-3">
      <% if (topPosts && topPosts.length > 0) { %>
        <% topPosts.forEach(tp => { %>
          <div class="flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-800/50 transition">
            <div class="flex-1 min-w-0 pr-3">
              <h4 class="text-xs font-bold text-white truncate"><%= tp.title %></h4>
              <div class="text-[11px] text-slate-400 mt-0.5 flex items-center gap-2">
                <span><%= tp.category_name || 'Software' %></span>
                <span>•</span>
                <span class="text-blue-400 font-semibold"><%= tp.views_count %> views</span>
                <span>•</span>
                <span class="text-emerald-400 font-semibold"><%= tp.downloads_count %> unduhan</span>
              </div>
            </div>
            <a href="/admin/posts/<%= tp.id %>/edit" class="text-xs bg-slate-800 hover:bg-blue-600 text-slate-300 hover:text-white px-2.5 py-1.5 rounded-lg transition font-semibold">
              Edit
            </a>
          </div>
        <% }) %>
      <% } else { %>
        <p class="text-xs text-slate-400 text-center py-4">Belum ada data software.</p>
      <% } %>
    </div>
  </div>

  <!-- Recent Software Requests -->
  <div class="bg-[#151f32] border border-slate-800 rounded-2xl p-6 shadow-sm">
    <div class="flex items-center justify-between pb-4 mb-4 border-b border-slate-800">
      <h3 class="text-sm font-bold text-white uppercase tracking-wider flex items-center gap-2">
        <i class="fa-solid fa-paper-plane text-blue-400"></i> Request Pengunjung Terbaru
      </h3>
      <a href="/admin/requests" class="text-xs text-blue-400 hover:underline">Kelola Request</a>
    </div>

    <div class="space-y-3">
      <% if (recentRequests && recentRequests.length > 0) { %>
        <% recentRequests.forEach(reqItem => { %>
          <div class="flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-800/50 transition">
            <div class="flex-1 min-w-0 pr-3">
              <h4 class="text-xs font-bold text-white truncate"><%= reqItem.software_name %></h4>
              <div class="text-[11px] text-slate-400 mt-0.5 flex items-center gap-2">
                <span>Oleh: <%= reqItem.name %></span>
                <span>•</span>
                <span class="text-slate-500"><%= formatDate(reqItem.created_at) %></span>
              </div>
            </div>
            <div>
              <% if (reqItem.status === 'completed') { %>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">Uploaded</span>
              <% } else if (reqItem.status === 'rejected') { %>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-rose-500/20 text-rose-400 border border-rose-500/30">Rejected</span>
              <% } else { %>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/20 text-amber-400 border border-amber-500/30">Pending</span>
              <% } %>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p class="text-xs text-slate-400 text-center py-4">Belum ada request software.</p>
      <% } %>
    </div>
  </div>

</div>

<%- include('layout-footer') %>
