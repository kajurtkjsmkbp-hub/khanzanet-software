<%- include('../layout-header') %>

<div class="space-y-6">

  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-xl font-black text-white flex items-center gap-2.5">
        <i class="fa-solid fa-rectangle-ad text-amber-400"></i> Kelola Slot Iklan & Sponsor
      </h1>
      <p class="text-xs text-slate-400 mt-0.5">Pasang kode banner, Google AdSense, atau link sponsor di berbagai posisi strategis website.</p>
    </div>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div class="p-4 rounded-xl bg-emerald-950/70 border border-emerald-800 text-emerald-300 text-xs font-semibold flex items-center gap-2">
      <i class="fa-solid fa-circle-check text-base"></i>
      <%= success %>
    </div>
  <% } %>

  <form action="/admin/ads" method="POST" class="space-y-6">

    <!-- Slot 1: Header Top Banner -->
    <div class="bg-[#151f32] border border-slate-800 rounded-2xl p-6 shadow-sm space-y-3">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-sm font-bold text-white flex items-center gap-2">
            <span class="w-6 h-6 rounded-lg bg-blue-600/20 text-blue-400 flex items-center justify-center text-xs font-black">1</span>
            Header Banner (Atas Beranda & Setiap Halaman)
          </h3>
          <p class="text-xs text-slate-400 mt-0.5">Muncul di bagian atas persis di bawah navigasi (Rekomendasi ukuran: Responsif atau 728x90 px).</p>
        </div>
        <span class="text-[10px] font-mono bg-slate-800 text-slate-300 px-2.5 py-1 rounded-md border border-slate-700">ad_header</span>
      </div>
      <textarea 
        name="ad_header" 
        rows="3" 
        placeholder="Paste kode HTML banner (misal: <a href='...'><img src='...' /></a>) atau kode script iklan Google AdSense..." 
        class="w-full bg-[#121927] border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs text-amber-200 placeholder-slate-500 focus:outline-none focus:border-blue-500 font-mono"
      ><%= settings.ad_header || '' %></textarea>
    </div>

    <!-- Slot 2: Download Gate Banner -->
    <div class="bg-[#151f32] border border-slate-800 rounded-2xl p-6 shadow-sm space-y-3">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-sm font-bold text-white flex items-center gap-2">
            <span class="w-6 h-6 rounded-lg bg-emerald-600/20 text-emerald-400 flex items-center justify-center text-xs font-black">2</span>
            Download Gate Banner (Halaman Hitung Mundur)
          </h3>
          <p class="text-xs text-slate-400 mt-0.5">Slot iklan dengan tayangan tinggi (High Impression) tepat di samping/atas tombol hitung mundur 5 detik.</p>
        </div>
        <span class="text-[10px] font-mono bg-slate-800 text-slate-300 px-2.5 py-1 rounded-md border border-slate-700">ad_download_gate</span>
      </div>
      <textarea 
        name="ad_download_gate" 
        rows="3" 
        placeholder="Paste kode HTML banner download gate atau skrip sponsor..." 
        class="w-full bg-[#121927] border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs text-amber-200 placeholder-slate-500 focus:outline-none focus:border-blue-500 font-mono"
      ><%= settings.ad_download_gate || '' %></textarea>
    </div>

    <!-- Slot 3: Article Bottom Banner -->
    <div class="bg-[#151f32] border border-slate-800 rounded-2xl p-6 shadow-sm space-y-3">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-sm font-bold text-white flex items-center gap-2">
            <span class="w-6 h-6 rounded-lg bg-purple-600/20 text-purple-400 flex items-center justify-center text-xs font-black">3</span>
            Bawah Artikel / Sebelum Tombol Download
          </h3>
          <p class="text-xs text-slate-400 mt-0.5">Ditampilkan di dalam detail software tepat sebelum kotak Download Center (High CTR).</p>
        </div>
        <span class="text-[10px] font-mono bg-slate-800 text-slate-300 px-2.5 py-1 rounded-md border border-slate-700">ad_article_bottom</span>
      </div>
      <textarea 
        name="ad_article_bottom" 
        rows="3" 
        placeholder="Paste kode iklan banner sebelum tombol download..." 
        class="w-full bg-[#121927] border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs text-amber-200 placeholder-slate-500 focus:outline-none focus:border-blue-500 font-mono"
      ><%= settings.ad_article_bottom || '' %></textarea>
    </div>

    <!-- Slot 4: Sidebar Banner -->
    <div class="bg-[#151f32] border border-slate-800 rounded-2xl p-6 shadow-sm space-y-3">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-sm font-bold text-white flex items-center gap-2">
            <span class="w-6 h-6 rounded-lg bg-sky-600/20 text-sky-400 flex items-center justify-center text-xs font-black">4</span>
            Sidebar Widget Banner
          </h3>
          <p class="text-xs text-slate-400 mt-0.5">Muncul di panel samping halaman beranda dan artikel (Rekomendasi ukuran: 300x250 px).</p>
        </div>
        <span class="text-[10px] font-mono bg-slate-800 text-slate-300 px-2.5 py-1 rounded-md border border-slate-700">ad_sidebar</span>
      </div>
      <textarea 
        name="ad_sidebar" 
        rows="3" 
        placeholder="Paste banner kotak 300x250 untuk sidebar..." 
        class="w-full bg-[#121927] border border-slate-700 rounded-xl px-3.5 py-2.5 text-xs text-amber-200 placeholder-slate-500 focus:outline-none focus:border-blue-500 font-mono"
      ><%= settings.ad_sidebar || '' %></textarea>
    </div>

    <div class="flex justify-end pt-2">
      <button type="submit" class="bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs py-2.5 px-6 rounded-xl transition flex items-center gap-2 shadow-lg shadow-blue-500/20">
        <i class="fa-solid fa-floppy-disk"></i> Simpan Semua Slot Iklan
      </button>
    </div>

  </form>

</div>

<%- include('../layout-footer') %>
