<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="max-w-4xl mx-auto px-4 sm:px-6 py-10 flex-1 w-full">

  <!-- Breadcrumbs -->
  <nav class="flex items-center space-x-2 text-xs text-slate-400 mb-6 justify-center">
    <a href="/" class="hover:text-blue-400">Beranda</a>
    <i class="fa-solid fa-chevron-right text-[10px] text-slate-600"></i>
    <a href="/software/<%= post.slug %>" class="hover:text-blue-400 truncate max-w-xs"><%= post.title %></a>
    <i class="fa-solid fa-chevron-right text-[10px] text-slate-600"></i>
    <span class="text-slate-200 font-semibold">Safe Download Gate</span>
  </nav>

  <!-- Top Ad Slot (if configured in CMS) -->
  <% if (settings.ad_download_gate) { %>
    <div class="mb-6 p-3 bg-slate-900/60 border border-slate-800 rounded-xl text-center overflow-hidden">
      <%- settings.ad_download_gate %>
    </div>
  <% } %>

  <!-- Main Gateway Container -->
  <div class="bg-gradient-to-b from-[#151f32] to-[#0f172a] border-2 border-blue-500/40 rounded-3xl p-6 sm:p-10 shadow-2xl relative overflow-hidden">
    
    <!-- Top Security Badge -->
    <div class="text-center mb-8">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full text-xs font-black tracking-wider uppercase bg-blue-500/20 text-blue-400 border border-blue-500/30 shadow mb-3">
        <i class="fa-solid fa-shield-halved text-emerald-400"></i> KHANZA.NET SAFE GATEWAY
      </div>
      <h1 class="text-2xl sm:text-3xl font-black text-white">
        Download <%= post.title %>
      </h1>
      <p class="text-xs text-slate-400 mt-1">
        Server Pilihan: <strong class="text-sky-400"><%= link.server_name %></strong> • Tipe: <span class="capitalize text-slate-300"><%= link.link_type %></span>
      </p>
    </div>

    <!-- Software Overview Card -->
    <div class="bg-[#121927] border border-slate-800 rounded-2xl p-5 mb-8 flex flex-col sm:flex-row items-center gap-5">
      <img src="<%= post.thumbnail %>" alt="<%= post.title %>" class="w-24 h-24 object-cover rounded-xl border border-slate-700 shadow shrink-0" onerror="this.src='https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=200&auto=format&fit=crop&q=80'">
      <div class="flex-1 min-w-0 text-center sm:text-left">
        <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 mb-1.5">
          <span class="px-2.5 py-0.5 rounded text-[10px] font-bold bg-blue-600/30 text-blue-300 border border-blue-500/30 font-mono">
            <%= post.version || 'Full Version' %>
          </span>
          <span class="px-2.5 py-0.5 rounded text-[10px] font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
            <i class="fa-solid fa-check-circle mr-1"></i> Tested & Working
          </span>
          <% if (post.file_size) { %>
            <span class="px-2.5 py-0.5 rounded text-[10px] font-semibold bg-slate-800 text-slate-300">
              <i class="fa-solid fa-hdd text-blue-400 mr-1"></i> <%= post.file_size %>
            </span>
          <% } %>
        </div>
        <h2 class="text-base font-bold text-white truncate"><%= post.title %></h2>
        <div class="text-xs text-slate-400 mt-1 flex flex-wrap items-center justify-center sm:justify-start gap-3">
          <span><i class="fa-brands fa-windows text-blue-400 mr-1"></i> <%= post.os_support || 'Windows 10/11' %></span>
          <span>•</span>
          <span><i class="fa-solid fa-microchip text-slate-500 mr-1"></i> <%= post.architecture || '64-bit' %></span>
        </div>
      </div>
    </div>

    <!-- Password WinRAR & Checksum Box -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
      <!-- RAR Password -->
      <div class="password-box rounded-xl p-4 flex items-center justify-between">
        <div>
          <div class="text-[11px] text-slate-400 font-semibold uppercase tracking-wider">Password WinRAR:</div>
          <div class="text-base font-mono font-black text-amber-400 tracking-wider">
            <%= post.rar_password || settings.default_rar_password || 'Khanza.NET' %>
          </div>
        </div>
        <button 
          type="button" 
          onclick="copyPassword(this, '<%= post.rar_password || settings.default_rar_password || 'Khanza.NET' %>')" 
          class="bg-slate-800 hover:bg-slate-700 text-white border border-slate-600 text-xs font-bold py-2 px-3.5 rounded-lg transition flex items-center gap-1.5 shadow"
        >
          <i class="fa-regular fa-copy"></i> Salin
        </button>
      </div>

      <!-- SHA-256 Checksum -->
      <div class="bg-[#121927] border border-slate-800 rounded-xl p-4 flex items-center justify-between">
        <div class="min-w-0 pr-2">
          <div class="text-[11px] text-slate-400 font-semibold uppercase tracking-wider">SHA-256 Checksum:</div>
          <div class="text-xs font-mono text-sky-400 truncate max-w-[200px]" title="<%= post.checksum_sha256 || 'SHA-256 terverifikasi aman' %>">
            <%= post.checksum_sha256 || 'Verified 100% Clean' %>
          </div>
        </div>
        <% if (post.checksum_sha256) { %>
          <button 
            type="button" 
            onclick="copyPassword(this, '<%= post.checksum_sha256 %>')" 
            class="bg-slate-800 hover:bg-slate-700 text-white border border-slate-600 text-xs font-bold py-2 px-3.5 rounded-lg transition shrink-0 flex items-center gap-1.5 shadow"
          >
            <i class="fa-regular fa-copy"></i> Salin
          </button>
        <% } else { %>
          <span class="text-xs text-emerald-400 font-bold flex items-center gap-1"><i class="fa-solid fa-shield-virus"></i> Clean</span>
        <% } %>
      </div>
    </div>

    <!-- Download Gate Sponsor Ad -->
    <% if (typeof settings !== 'undefined' && settings.ad_download_gate && settings.ad_download_gate.trim()) { %>
      <div class="mb-8 bg-[#121927] border border-slate-800 rounded-xl p-4 text-center overflow-hidden">
        <div class="text-[9px] text-slate-500 uppercase tracking-widest font-semibold mb-2">Sponsor Unduhan</div>
        <div class="flex justify-center items-center">
          <%- settings.ad_download_gate %>
        </div>
      </div>
    <% } %>

    <!-- COUNTDOWN TIMER & DOWNLOAD BUTTON SECTION -->
    <div class="text-center py-6 border-y border-slate-800 mb-8">
      
      <div id="countdownBox" class="mb-5">
        <div class="inline-flex items-center justify-center w-20 h-20 rounded-full border-4 border-blue-500/30 border-t-blue-500 animate-spin mb-3">
          <span id="countdownNumber" class="text-2xl font-black text-white" style="transform: rotate(0deg);">5</span>
        </div>
        <p class="text-sm font-bold text-slate-300">
          Menyiapkan link unduhan aman... Mohon tunggu <span id="countdownText" class="text-blue-400 font-black">5</span> detik
        </p>
        <p class="text-xs text-slate-500 mt-1">Pengecekan integritas file dan validasi server mirror selesai.</p>
      </div>

      <!-- Action Button (Toggled after countdown) -->
      <div id="actionBtnArea" class="max-w-md mx-auto">
        <button id="placeholderBtn" disabled class="w-full bg-slate-800 text-slate-500 font-bold text-sm py-4 px-6 rounded-2xl cursor-not-allowed flex items-center justify-center gap-2 border border-slate-700">
          <i class="fa-solid fa-spinner fa-spin"></i> Menyiapkan Link Unduhan...
        </button>

        <a 
          id="realDlBtn" 
          href="/download/direct/<%= link.id %>" 
          class="hidden w-full bg-gradient-to-r from-emerald-600 via-teal-600 to-emerald-500 hover:from-emerald-500 hover:to-teal-500 text-white font-black text-base py-4 px-6 rounded-2xl shadow-xl shadow-emerald-600/30 transition transform hover:scale-[1.02] flex items-center justify-center gap-3 animate-pulse"
        >
          <i class="fa-solid fa-cloud-arrow-down text-xl"></i> Unduh Sekarang (<%= link.server_name %>)
        </a>
      </div>

    </div>

    <!-- Alternative Mirrors & Broken Link Report Action -->
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
      
      <!-- Report Broken Link Button -->
      <button 
        type="button" 
        onclick="openReportModal()" 
        class="text-rose-400 hover:text-rose-300 transition font-semibold flex items-center gap-1.5"
      >
        <i class="fa-solid fa-triangle-exclamation"></i> Link ini limit atau mati? Laporkan ke Admin
      </button>

      <!-- Alternative Mirror Links -->
      <% if (otherLinks && otherLinks.length > 0) { %>
        <div class="flex items-center gap-2 text-slate-400">
          <span>Server Alternatif:</span>
          <% otherLinks.slice(0, 3).forEach(ol => { %>
            <a href="/download/<%= ol.id %>" class="px-2.5 py-1 rounded-lg bg-slate-800 hover:bg-slate-700 text-sky-400 font-semibold border border-slate-700 transition">
              <%= ol.server_name %>
            </a>
          <% }) %>
        </div>
      <% } %>

    </div>

  </div>

  <!-- Back to Software Detail Link -->
  <div class="text-center mt-6">
    <a href="/software/<%= post.slug %>" class="text-xs font-semibold text-slate-400 hover:text-white transition inline-flex items-center gap-2">
      <i class="fa-solid fa-arrow-left text-[10px]"></i> Kembali ke Halaman Detail Software
    </a>
  </div>

</main>

<!-- Broken Link Report Modal -->
<div id="reportModal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden flex items-center justify-center p-4">
  <div class="bg-[#151f32] border border-slate-800 rounded-2xl w-full max-w-md p-6 shadow-2xl">
    <div class="flex items-center justify-between pb-3 mb-4 border-b border-slate-800">
      <h3 class="text-sm font-bold text-white flex items-center gap-2">
        <i class="fa-solid fa-triangle-exclamation text-rose-500"></i> Laporkan Link Bermasalah
      </h3>
      <button type="button" onclick="closeReportModal()" class="text-slate-400 hover:text-white">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
    </div>

    <form action="/report-broken-link" method="POST" class="space-y-4">
      <input type="hidden" name="post_id" value="<%= post.id %>">
      <input type="hidden" name="link_id" value="<%= link.id %>">

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Software & Server</label>
        <input type="text" readonly value="<%= post.title %> (<%= link.server_name %>)" class="w-full bg-[#121927] border border-slate-800 rounded-xl px-3 py-2 text-xs text-slate-400 cursor-not-allowed">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Nama Anda (Opsional)</label>
        <input type="text" name="reporter_name" placeholder="Nama / Panggilan" class="w-full bg-[#121927] border border-slate-700 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-blue-500">
      </div>

      <div>
        <label class="block text-xs font-semibold text-slate-300 mb-1">Kendala yang Dialami *</label>
        <select name="reason" required class="w-full bg-[#121927] border border-slate-700 rounded-xl px-3 py-2 text-xs text-white focus:outline-none focus:border-blue-500">
          <option value="Google Drive Quota Exceeded (Limit 24 Jam)">Google Drive Quota Exceeded (Limit 24 Jam)</option>
          <option value="File Telah Dihapus / 404 Not Found">File Telah Dihapus / 404 Not Found</option>
          <option value="File Rusak / Corrupt Saat Diekstrak">File Rusak / Corrupt Saat Diekstrak</option>
          <option value="Password Salah / Tidak Cocok">Password Salah / Tidak Cocok</option>
          <option value="Lainnya">Kendala Lainnya</option>
        </select>
      </div>

      <div class="flex items-center justify-end gap-2 pt-2">
        <button type="button" onclick="closeReportModal()" class="bg-slate-800 hover:bg-slate-700 text-slate-300 font-bold text-xs py-2 px-4 rounded-xl">Batal</button>
        <button type="submit" class="bg-rose-600 hover:bg-rose-500 text-white font-bold text-xs py-2 px-5 rounded-xl shadow-md transition">Kirim Laporan</button>
      </div>
    </form>
  </div>
</div>

<script>
  // Countdown Timer Logic
  let timeLeft = 5;
  const countdownNumber = document.getElementById('countdownNumber');
  const countdownText = document.getElementById('countdownText');
  const countdownBox = document.getElementById('countdownBox');
  const placeholderBtn = document.getElementById('placeholderBtn');
  const realDlBtn = document.getElementById('realDlBtn');

  const timer = setInterval(() => {
    timeLeft--;
    if (countdownNumber) countdownNumber.textContent = timeLeft;
    if (countdownText) countdownText.textContent = timeLeft;

    if (timeLeft <= 0) {
      clearInterval(timer);
      if (countdownBox) {
        countdownBox.innerHTML = `
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 mb-2">
            <i class="fa-solid fa-circle-check"></i> Link Unduhan Siap!
          </div>
          <p class="text-xs text-slate-400">Klik tombol hijau di bawah untuk memulai pengunduhan langsung.</p>
        `;
      }
      if (placeholderBtn) placeholderBtn.classList.add('hidden');
      if (realDlBtn) realDlBtn.classList.remove('hidden');
    }
  }, 1000);

  // Modal controls
  function openReportModal() {
    document.getElementById('reportModal').classList.remove('hidden');
  }
  function closeReportModal() {
    document.getElementById('reportModal').classList.add('hidden');
  }
</script>

<%- include('partials/footer') %>
