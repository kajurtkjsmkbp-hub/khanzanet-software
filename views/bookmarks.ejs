<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-1">
  
  <!-- Breadcrumb -->
  <div class="flex items-center space-x-2 text-xs text-slate-400 mb-6">
    <a href="/" class="hover:text-blue-400 transition flex items-center gap-1">
      <i class="fa-solid fa-house"></i> Beranda
    </a>
    <i class="fa-solid fa-chevron-right text-[10px] text-slate-600"></i>
    <span class="text-slate-200 font-semibold">Koleksi Favorit Saya</span>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
    
    <!-- Main Content Area -->
    <div class="lg:col-span-3 space-y-6">
      
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 pb-4 border-b border-slate-800">
        <div>
          <h1 class="text-xl sm:text-2xl font-black text-white flex items-center gap-2.5">
            <i class="fa-solid fa-heart text-rose-500 animate-pulse"></i> Koleksi Favorit Saya
          </h1>
          <p class="text-xs text-slate-400 mt-1">Daftar software dan game yang Anda simpan untuk diunduh nanti (Tersimpan aman di browser Anda tanpa perlu login).</p>
        </div>
        <div id="clearAllArea" class="hidden">
          <button onclick="clearAllBookmarks()" class="bg-rose-950/60 hover:bg-rose-900 border border-rose-800/80 text-rose-300 text-xs font-bold py-2 px-3.5 rounded-xl transition flex items-center gap-1.5 shadow">
            <i class="fa-solid fa-trash-can"></i> Hapus Semua
          </button>
        </div>
      </div>

      <!-- Bookmarks Dynamic Grid -->
      <div id="bookmarksContainer" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5">
        <!-- Injected via JavaScript -->
      </div>

      <!-- Empty State -->
      <div id="bookmarksEmpty" class="hidden py-16 text-center bg-[#151f32] border border-slate-800 rounded-2xl p-8">
        <div class="w-16 h-16 rounded-2xl bg-rose-500/10 text-rose-400 border border-rose-500/20 flex items-center justify-center text-3xl mx-auto mb-4">
          <i class="fa-regular fa-heart"></i>
        </div>
        <h3 class="text-base font-bold text-white mb-1">Belum Ada Software yang Disimpan</h3>
        <p class="text-xs text-slate-400 max-w-sm mx-auto mb-6">
          Klik tombol hati (<i class="fa-regular fa-heart text-rose-400"></i>) pada kartu software apa pun untuk menyimpannya ke koleksi Anda.
        </p>
        <a href="/" class="bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs py-2.5 px-6 rounded-xl transition inline-flex items-center gap-2 shadow-lg shadow-blue-500/20">
          <i class="fa-solid fa-compass"></i> Jelajahi Software Terbaru
        </a>
      </div>

    </div>

    <!-- Sidebar Area -->
    <div class="lg:col-span-1">
      <%- include('partials/sidebar') %>
    </div>

  </div>

</main>

<script>
  function renderBookmarksPage() {
    const list = getBookmarks();
    const container = document.getElementById('bookmarksContainer');
    const emptyBox = document.getElementById('bookmarksEmpty');
    const clearBtn = document.getElementById('clearAllArea');

    if (!list || list.length === 0) {
      container.innerHTML = '';
      container.classList.add('hidden');
      emptyBox.classList.remove('hidden');
      clearBtn.classList.add('hidden');
      return;
    }

    emptyBox.classList.add('hidden');
    container.classList.remove('hidden');
    clearBtn.classList.remove('hidden');

    let html = '';
    list.forEach(item => {
      html += `
        <div class="software-card bg-[#151f32] border border-slate-800 rounded-2xl overflow-hidden shadow-sm flex flex-col group transition-all duration-300 hover:border-slate-700 hover:shadow-xl">
          <div class="relative overflow-hidden h-40 bg-slate-900">
            <a href="/software/${item.slug}">
              <img src="${item.thumbnail}" alt="${item.title}" class="w-full h-full object-cover group-hover:scale-105 transition duration-500" onerror="this.src='https://images.unsplash.com/photo-1550751827-4bd374c3f58b?w=600&auto=format&fit=crop&q=80'">
            </a>
            <button onclick="removeBookmarkFromPage('${item.id}')" class="absolute top-2.5 right-2.5 w-8 h-8 rounded-full bg-slate-900/80 backdrop-blur text-rose-400 hover:bg-rose-600 hover:text-white transition flex items-center justify-center shadow" title="Hapus dari Favorit">
              <i class="fa-solid fa-xmark text-sm"></i>
            </button>
            ${item.version ? `<span class="absolute bottom-2.5 left-2.5 bg-slate-950/80 backdrop-blur text-sky-400 text-[10px] font-mono font-bold px-2 py-0.5 rounded border border-slate-700/80">${item.version}</span>` : ''}
          </div>
          <div class="p-4 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="text-xs font-bold text-white line-clamp-2 group-hover:text-blue-400 transition leading-snug">
                <a href="/software/${item.slug}">${item.title}</a>
              </h3>
            </div>
            <div class="pt-3 mt-3 border-t border-slate-800/80 flex items-center justify-between">
              <a href="/software/${item.slug}" class="w-full bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs py-2 px-3 rounded-xl transition text-center shadow flex items-center justify-center gap-1.5">
                <i class="fa-solid fa-download text-xs"></i> Unduh Sekarang
              </a>
            </div>
          </div>
        </div>
      `;
    });

    container.innerHTML = html;
  }

  function removeBookmarkFromPage(id) {
    let list = getBookmarks();
    list = list.filter(item => String(item.id) !== String(id));
    localStorage.setItem('khanza_bookmarks', JSON.stringify(list));
    updateBookmarkBadge();
    renderBookmarksPage();
  }

  function clearAllBookmarks() {
    if (confirm('Hapus semua software dari daftar favorit Anda?')) {
      localStorage.removeItem('khanza_bookmarks');
      updateBookmarkBadge();
      renderBookmarksPage();
    }
  }

  document.addEventListener('DOMContentLoaded', renderBookmarksPage);
</script>

<%- include('partials/footer') %>
